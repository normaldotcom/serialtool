<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SerialTool colors for the light theme (controls themselves come from WPF Fluent ThemeMode). -->
    <SolidColorBrush x:Key="AppBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BarBackground" Color="#F7F7F7" />
    <SolidColorBrush x:Key="BarBorder" Color="#DDDDDD" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#CCCCCC" />
    <SolidColorBrush x:Key="StrongText" Color="#333333" />
    <SolidColorBrush x:Key="StatusText" Color="#555555" />
    <SolidColorBrush x:Key="SubtleText" Color="#666666" />
    <SolidColorBrush x:Key="MutedText" Color="#777777" />
    <SolidColorBrush x:Key="FaintText" Color="#999999" />
    <SolidColorBrush x:Key="ErrorText" Color="#C62828" />
    <SolidColorBrush x:Key="WarningText" Color="#B26A00" />
    <SolidColorBrush x:Key="AccentText" Color="#0B5CAD" />
    <SolidColorBrush x:Key="MacroText" Color="#8A6400" />
    <SolidColorBrush x:Key="PopupBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PopupBorder" Color="#A0A0A0" />
    <SolidColorBrush x:Key="PopupFooter" Color="#F3F3F3" />
    <SolidColorBrush x:Key="SearchBarBackground" Color="#FFF8E1" />
    <SolidColorBrush x:Key="SearchBarBorder" Color="#E6DCA8" />
    <SolidColorBrush x:Key="LedOff" Color="#D0D0D0" />
    <SolidColorBrush x:Key="LedOffStroke" Color="#909090" />
    <SolidColorBrush x:Key="LedOn" Color="#2EB82E" />
    <SolidColorBrush x:Key="LedOnStroke" Color="#1E7A1E" />
</ResourceDictionary>
