<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SerialTool colors for the dark theme (controls themselves come from WPF Fluent ThemeMode). -->
    <SolidColorBrush x:Key="AppBackground" Color="#1F1F1F" />
    <SolidColorBrush x:Key="BarBackground" Color="#2A2A2A" />
    <SolidColorBrush x:Key="BarBorder" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="StrongText" Color="#DDDDDD" />
    <SolidColorBrush x:Key="StatusText" Color="#B4B4B4" />
    <SolidColorBrush x:Key="SubtleText" Color="#A8A8A8" />
    <SolidColorBrush x:Key="MutedText" Color="#9A9A9A" />
    <SolidColorBrush x:Key="FaintText" Color="#808080" />
    <SolidColorBrush x:Key="ErrorText" Color="#FF7070" />
    <SolidColorBrush x:Key="WarningText" Color="#E8A33C" />
    <SolidColorBrush x:Key="AccentText" Color="#5CB4FF" />
    <SolidColorBrush x:Key="MacroText" Color="#D8B040" />
    <SolidColorBrush x:Key="PopupBackground" Color="#2B2B2B" />
    <SolidColorBrush x:Key="PopupBorder" Color="#555555" />
    <SolidColorBrush x:Key="PopupFooter" Color="#242424" />
    <SolidColorBrush x:Key="SearchBarBackground" Color="#3A3320" />
    <SolidColorBrush x:Key="SearchBarBorder" Color="#5A4E28" />
    <SolidColorBrush x:Key="LedOff" Color="#484848" />
    <SolidColorBrush x:Key="LedOffStroke" Color="#6A6A6A" />
    <SolidColorBrush x:Key="LedOn" Color="#2EB82E" />
    <SolidColorBrush x:Key="LedOnStroke" Color="#6EE06E" />
</ResourceDictionary>
