<Window x:Class="SerialTool.App.MacroWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialTool.App"
        xmlns:vm="clr-namespace:SerialTool.App.ViewModels"
        Title="Macro" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <local:EnumDisplayConverter x:Key="EnumDisplay" />
        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>
    </Window.Resources>
    <StackPanel Margin="14">
        <TextBlock Text="Name (button label)" />
        <TextBox x:Name="NameBox" Margin="0,3,0,10" Padding="2,3" />
        <TextBlock Text="Data" />
        <TextBox x:Name="TextBox" Margin="0,3,0,4" Padding="2,3" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                 TextChanged="OnTextChanged" />
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="ModeBox" Width="90" ItemsSource="{x:Static vm:MainViewModel.SendModes}"
                      ItemTemplate="{StaticResource EnumItem}" SelectionChanged="OnModeChanged" />
            <TextBlock Text="Line ending" VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox x:Name="EndingBox" Width="110" ItemsSource="{x:Static vm:MainViewModel.LineEndings}"
                      ItemTemplate="{StaticResource EnumItem}" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="#C62828" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <TextBlock Foreground="#777" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Hex: 0xDEADBEEF or 01 02 AA. Escaped: \r \n \t \0 \\ \xHH. Macros 1–9 also send with Ctrl+1…Ctrl+9." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="OK" IsDefault="True" Width="80" Margin="0,0,6,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
