<Window x:Class="SerialTool.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SerialTool.App"
        xmlns:vm="clr-namespace:SerialTool.App.ViewModels"
        xmlns:controls="clr-namespace:SerialTool.App.Controls"
        Title="{Binding Title}" Height="720" Width="1100" MinWidth="640" MinHeight="400"
        FontFamily="Segoe UI" FontSize="12"
        UseLayoutRounding="True" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <local:EnumBoolConverter x:Key="EnumBool" />
        <local:EnumDisplayConverter x:Key="EnumDisplay" />
        <local:BoolToVisibilityConverter x:Key="BoolVis" />
        <local:BoolToVisibilityConverter x:Key="BoolVisInv" Invert="True" />
        <local:NotConverter x:Key="Not" />
        <local:NonZeroToVisibilityConverter x:Key="NonZeroVis" />
        <local:NonZeroToVisibilityConverter x:Key="ZeroVis" Invert="True" />
        <local:NotEmptyToVisibilityConverter x:Key="NotEmptyVis" />
        <local:IntEqualsConverter x:Key="IntEquals" />
        <local:MacroTipConverter x:Key="MacroTip" />

        <!-- Flat little buttons for list rows / bars -->
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <DataTemplate x:Key="EnumItem">
            <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
        </DataTemplate>

        <Style x:Key="Led" TargetType="Ellipse">
            <Setter Property="Width" Value="10" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="6,0,3,0" />
            <Setter Property="Fill" Value="#D0D0D0" />
            <Setter Property="Stroke" Value="#909090" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Fill" Value="#2EB82E" />
                    <Setter Property="Stroke" Value="#1E7A1E" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="ToggleButton">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="L" Modifiers="Control" Command="{Binding ClearCommand}" />
        <KeyBinding Key="Pause" Command="{Binding TogglePauseCommand}" />
        <KeyBinding Key="H" Modifiers="Control" Command="{Binding ToggleHexCommand}" />
        <KeyBinding Key="F3" Command="{Binding FindNextCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding FindPreviousCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="5" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="6" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="7" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="8" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding SendMacroNumberCommand}" CommandParameter="9" />
    </Window.InputBindings>

    <DockPanel>
        <!-- Menu -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open Session…" InputGestureText="Ctrl+O" Click="OnOpenSession" />
                <MenuItem Header="_Export Buffer…" Click="OnExport" IsEnabled="{Binding IsExporting, Converter={StaticResource Not}}" />
                <Separator />
                <MenuItem Header="Start _Logging…" Click="OnStartLog" Visibility="{Binding IsLogging, Converter={StaticResource BoolVisInv}}" />
                <MenuItem Header="Stop _Logging" Command="{Binding StopLogCommand}" Visibility="{Binding IsLogging, Converter={StaticResource BoolVis}}" />
                <MenuItem Header="Log _Settings…" Click="OnLogSettings" />
                <Separator />
                <MenuItem Header="_Send File…" Click="OnSendFile" IsEnabled="{Binding IsConnected}" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy" InputGestureText="Ctrl+C" Click="OnCopy" />
                <MenuItem Header="Copy _as">
                    <MenuItem Header="_Text" Tag="Text" Click="OnCopyAs" />
                    <MenuItem Header="_Hex string" Tag="Hex" Click="OnCopyAs" />
                    <MenuItem Header="_C array" Tag="CArray" Click="OnCopyAs" />
                    <MenuItem Header="_Base64" Tag="Base64" Click="OnCopyAs" />
                </MenuItem>
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="OnSelectAll" />
                <Separator />
                <MenuItem Header="_Find…" InputGestureText="Ctrl+F" Click="OnFind" />
                <MenuItem Header="Find _next" InputGestureText="F3" Command="{Binding FindNextCommand}" />
                <MenuItem Header="Find _previous" InputGestureText="Shift+F3" Command="{Binding FindPreviousCommand}" />
                <Separator />
                <MenuItem Header="C_lear" InputGestureText="Ctrl+L" Command="{Binding ClearCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Timestamps">
                    <MenuItem Header="_Off" IsCheckable="True" IsChecked="{Binding Timestamps, Converter={StaticResource EnumBool}, ConverterParameter=Off}" />
                    <MenuItem Header="_Absolute" IsCheckable="True" IsChecked="{Binding Timestamps, Converter={StaticResource EnumBool}, ConverterParameter=Absolute}" />
                    <MenuItem Header="_Delta from previous" IsCheckable="True" IsChecked="{Binding Timestamps, Converter={StaticResource EnumBool}, ConverterParameter=Delta}" />
                    <MenuItem Header="_Since connect" IsCheckable="True" IsChecked="{Binding Timestamps, Converter={StaticResource EnumBool}, ConverterParameter=SinceConnect}" />
                </MenuItem>
                <MenuItem Header="_Encoding">
                    <MenuItem Header="_ASCII" IsCheckable="True" IsChecked="{Binding Encoding, Converter={StaticResource EnumBool}, ConverterParameter=Ascii}" />
                    <MenuItem Header="_UTF-8" IsCheckable="True" IsChecked="{Binding Encoding, Converter={StaticResource EnumBool}, ConverterParameter=Utf8}" />
                    <MenuItem Header="_Latin-1" IsCheckable="True" IsChecked="{Binding Encoding, Converter={StaticResource EnumBool}, ConverterParameter=Latin1}" />
                </MenuItem>
                <MenuItem Header="_Control characters">
                    <MenuItem Header="_Hide" IsCheckable="True" IsChecked="{Binding ControlChars, Converter={StaticResource EnumBool}, ConverterParameter=Hide}" />
                    <MenuItem Header="_Escapes (\r &lt;02&gt;)" IsCheckable="True" IsChecked="{Binding ControlChars, Converter={StaticResource EnumBool}, ConverterParameter=Escapes}" />
                    <MenuItem Header="_Symbols (← ↓ &lt;02&gt;)" IsCheckable="True" IsChecked="{Binding ControlChars, Converter={StaticResource EnumBool}, ConverterParameter=Symbols}" />
                </MenuItem>
                <MenuItem Header="_Newline">
                    <MenuItem Header="_Any (CR, LF or CRLF)" IsCheckable="True" IsChecked="{Binding Newline, Converter={StaticResource EnumBool}, ConverterParameter=Any}" />
                    <MenuItem Header="_LF" IsCheckable="True" IsChecked="{Binding Newline, Converter={StaticResource EnumBool}, ConverterParameter=Lf}" />
                    <MenuItem Header="_CR" IsCheckable="True" IsChecked="{Binding Newline, Converter={StaticResource EnumBool}, ConverterParameter=Cr}" />
                    <MenuItem Header="CR_LF" IsCheckable="True" IsChecked="{Binding Newline, Converter={StaticResource EnumBool}, ConverterParameter=CrLf}" />
                    <MenuItem Header="Cu_stom…" IsChecked="{Binding Newline, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=Custom}" Click="OnLineSettings" />
                </MenuItem>
                <MenuItem Header="_Grouping">
                    <MenuItem Header="_Raw reads" IsCheckable="True" IsChecked="{Binding Grouping, Converter={StaticResource EnumBool}, ConverterParameter=RawRead}" />
                    <MenuItem Header="_Newline delimited" IsCheckable="True" IsChecked="{Binding Grouping, Converter={StaticResource EnumBool}, ConverterParameter=Delimiter}" />
                    <MenuItem Header="_Idle gap" IsCheckable="True" IsChecked="{Binding Grouping, Converter={StaticResource EnumBool}, ConverterParameter=IdleGap}" />
                </MenuItem>
                <MenuItem Header="_Line grouping settings…" Click="OnLineSettings" />
                <Separator />
                <MenuItem Header="Show _TX" IsCheckable="True" IsChecked="{Binding ShowTx}" />
                <MenuItem Header="Show _events" IsCheckable="True" IsChecked="{Binding ShowEvents}" />
                <MenuItem Header="_Word wrap" IsCheckable="True" IsChecked="{Binding WordWrap}" />
                <MenuItem Header="_Macro bar" IsCheckable="True" IsChecked="{Binding ShowMacroBar}" />
                <Separator />
                <MenuItem Header="He_x view" InputGestureText="Ctrl+H" IsCheckable="True" IsChecked="{Binding ShowHex}" />
                <MenuItem Header="Hex _bytes per row">
                    <MenuItem Header="_8" IsCheckable="True" IsChecked="{Binding HexBytesPerRow, Converter={StaticResource IntEquals}, ConverterParameter=8}" />
                    <MenuItem Header="_16" IsCheckable="True" IsChecked="{Binding HexBytesPerRow, Converter={StaticResource IntEquals}, ConverterParameter=16}" />
                    <MenuItem Header="_32" IsCheckable="True" IsChecked="{Binding HexBytesPerRow, Converter={StaticResource IntEquals}, ConverterParameter=32}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Pause display" InputGestureText="Pause" IsCheckable="True" IsChecked="{Binding IsPaused}" />
            </MenuItem>
            <MenuItem Header="_Connection">
                <MenuItem Header="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}" />
                <MenuItem Header="_Refresh ports" Command="{Binding RefreshPortsCommand}" />
                <Separator />
                <MenuItem Header="Assert _DTR on open" IsCheckable="True" IsChecked="{Binding DtrOnOpen}" />
                <MenuItem Header="Assert _RTS on open" IsCheckable="True" IsChecked="{Binding RtsOnOpen}" />
            </MenuItem>
        </Menu>

        <!-- Connection panel -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="8,6" Background="#F7F7F7">
            <StackPanel>
                <WrapPanel>
                    <ComboBox Width="330" ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}"
                              IsEnabled="{Binding IsDisconnected}" ToolTip="Serial port" DisplayMemberPath="Display" />
                    <Button Content="⟳" Padding="6,2" ToolTip="Refresh ports" Command="{Binding RefreshPortsCommand}" />
                    <ComboBox Width="90" IsEditable="True" ItemsSource="{x:Static vm:MainViewModel.BaudPresets}"
                              Text="{Binding BaudRateText, UpdateSourceTrigger=LostFocus}" ToolTip="Baud rate (type a custom value)" />
                    <ComboBox Width="44" ItemsSource="{x:Static vm:MainViewModel.DataBitsOptions}" SelectedItem="{Binding DataBits}" ToolTip="Data bits" />
                    <ComboBox Width="70" ItemsSource="{x:Static vm:MainViewModel.ParityOptions}" SelectedItem="{Binding Parity}" ToolTip="Parity" />
                    <ComboBox Width="48" ItemsSource="{x:Static vm:MainViewModel.StopBitsOptions}" SelectedItem="{Binding StopBits}"
                              ItemTemplate="{StaticResource EnumItem}" ToolTip="Stop bits" />
                    <ComboBox Width="120" ItemsSource="{x:Static vm:MainViewModel.FlowOptions}" SelectedItem="{Binding FlowControl}"
                              ItemTemplate="{StaticResource EnumItem}" ToolTip="Flow control" />
                    <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectionCommand}" MinWidth="90" FontWeight="SemiBold" />
                </WrapPanel>
                <WrapPanel Margin="0,6,0,0" VerticalAlignment="Center">
                    <ToggleButton Content="RTS" IsChecked="{Binding Rts}" IsEnabled="{Binding CanToggleRts}" ToolTip="Assert RTS" />
                    <ToggleButton Content="DTR" IsChecked="{Binding Dtr}" IsEnabled="{Binding CanToggleDtr}" ToolTip="Assert DTR" />
                    <ToggleButton Content="Break" IsChecked="{Binding BreakOn}" IsEnabled="{Binding IsConnected}" ToolTip="Hold TX in break state" />
                    <Ellipse Style="{StaticResource Led}" Tag="{Binding Cts}" ToolTip="Clear To Send" /><TextBlock Text="CTS" VerticalAlignment="Center" />
                    <Ellipse Style="{StaticResource Led}" Tag="{Binding Dsr}" ToolTip="Data Set Ready" /><TextBlock Text="DSR" VerticalAlignment="Center" />
                    <Ellipse Style="{StaticResource Led}" Tag="{Binding Dcd}" ToolTip="Data Carrier Detect" /><TextBlock Text="DCD" VerticalAlignment="Center" />
                    <Ellipse Style="{StaticResource Led}" Tag="{Binding Ri}" ToolTip="Ring Indicator" /><TextBlock Text="RI" VerticalAlignment="Center" />
                    <Rectangle Width="1" Fill="#CCCCCC" Margin="12,2" />
                    <ToggleButton Content="{Binding PauseText}" IsChecked="{Binding IsPaused}" ToolTip="Pause display (capture continues)" />
                    <Button Content="Clear" Command="{Binding ClearCommand}" ToolTip="Clear buffer (Ctrl+L)" Margin="4,0,0,0" />
                    <ToggleButton Content="Wrap" IsChecked="{Binding WordWrap}" ToolTip="Word wrap" Margin="4,0,0,0" />
                    <ToggleButton Content="Hex" IsChecked="{Binding ShowHex}" ToolTip="Switch between text and hex view (Ctrl+H)" />
                    <ToggleButton Content="TX" IsChecked="{Binding ShowTx}" ToolTip="Show transmitted data" />
                    <ToggleButton Content="Events" IsChecked="{Binding ShowEvents}" ToolTip="Show connection / pin / error events" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StateText}" FontWeight="SemiBold" />
            <Separator />
            <StatusBarItem Content="{Binding RxText}" />
            <StatusBarItem Content="{Binding TxText}" />
            <StatusBarItem Content="{Binding RateText}" />
            <Separator />
            <StatusBarItem Content="{Binding BufferText}" />
            <Separator />
            <StatusBarItem>
                <Hyperlink Click="OnLineSettings" Foreground="#333" TextDecorations="{x:Null}" ToolTip="Line grouping settings">
                    <Run Text="{Binding GroupingText, Mode=OneWay}" />
                </Hyperlink>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding PendingWrites, Converter={StaticResource NonZeroVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="#B26A00">
                        <Run Text="Sending… (" /><Run Text="{Binding PendingWrites, Mode=OneWay}" /><Run Text=" pending)" />
                    </TextBlock>
                    <Button Content="Cancel" Command="{Binding CancelSendsCommand}" Margin="6,0,0,0" Padding="6,0" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsLogging, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center">
                        <Hyperlink Click="OnShowLogFile" Foreground="#C62828" TextDecorations="{x:Null}" ToolTip="Show the log file in Explorer">
                            <Run Text="{Binding LogStatusText, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>
                    <Button Content="Stop" Command="{Binding StopLogCommand}" Margin="6,0,0,0" Padding="6,0" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsSendingFile, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="#B26A00" Text="{Binding SendFileText}" />
                    <Button Content="Cancel" Command="{Binding CancelSendsCommand}" Margin="6,0,0,0" Padding="6,0" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Visibility="{Binding IsPaused, Converter={StaticResource BoolVis}}">
                <TextBlock Text="DISPLAY PAUSED" Foreground="#B26A00" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding StateDetail}" Foreground="#C62828" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
        </StatusBar>

        <!-- Send box -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="8,6" Background="#F7F7F7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SendError}" Foreground="#C62828" Margin="0,4,0,0"
                           Visibility="{Binding SendError, Converter={StaticResource NotEmptyVis}}" />

                <!-- Macro bar -->
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6" Visibility="{Binding ShowMacroBar, Converter={StaticResource BoolVis}}">
                    <Button DockPanel.Dock="Right" Content="+ Macro" Padding="8,1" Margin="0" Click="OnAddMacro"
                            ToolTip="New macro (starts with the send box contents)" />
                    <TextBlock DockPanel.Dock="Left" Text="Macros" Foreground="#777" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="none yet — click + Macro here, or + Macro next to an entry in ▾ Recent" Foreground="#999" VerticalAlignment="Center" FontStyle="Italic"
                               Visibility="{Binding Macros.Count, Converter={StaticResource ZeroVis}}" />
                    <ItemsControl ItemsSource="{Binding Macros}" ToolTip="Click to send · right-click to edit · Ctrl+1…9 send the first nine">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Padding="8,1" Margin="0,0,4,2" ToolTip="{Binding Converter={StaticResource MacroTip}}"
                                        Command="{Binding DataContext.SendMacroCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="_Edit…" Click="OnEditMacro" />
                                            <MenuItem Header="Move _left" Click="OnMoveMacroLeft" />
                                            <MenuItem Header="Move _right" Click="OnMoveMacroRight" />
                                            <Separator />
                                            <MenuItem Header="_Delete" Click="OnDeleteMacro" />
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
                <ComboBox DockPanel.Dock="Left" Width="80" ItemsSource="{x:Static vm:MainViewModel.SendModes}" SelectedItem="{Binding SendMode}"
                          ItemTemplate="{StaticResource EnumItem}" ToolTip="Text / Hex (0xDEADBEEF, 01 02 AA) / Escaped (\r \n \t \0 \\ \xHH)" />
                <Button DockPanel.Dock="Right" Content="Send" Command="{Binding SendCommand}" Margin="6,0,0,0" MinWidth="70" />
                <ComboBox DockPanel.Dock="Right" Width="110" Margin="6,0,0,0" ItemsSource="{x:Static vm:MainViewModel.LineEndings}"
                          SelectedItem="{Binding LineEnding}" ItemTemplate="{StaticResource EnumItem}" IsEnabled="{Binding LineEndingEnabled}"
                          ToolTip="Appended to Text and Escaped sends" />
                <ToggleButton x:Name="RecentToggle" DockPanel.Dock="Right" Content="▾ Recent" Margin="6,0,0,0" Padding="6,0"
                              IsChecked="{Binding IsRecentOpen}" IsEnabled="{Binding HasHistory}"
                              ToolTip="Recent sends — pick one to resend (Alt+↓ or F4 in the send box)" />
                <TextBox x:Name="SendBox" Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                         FontSize="13" VerticalContentAlignment="Center" Padding="2,3" PreviewKeyDown="OnSendBoxKeyDown" />
            </DockPanel>
        </Border>

        <!-- Recent sends dropdown (opens above the send box) -->
        <Popup x:Name="RecentPopup" IsOpen="{Binding IsRecentOpen}" PlacementTarget="{Binding ElementName=SendBox}" Placement="Top"
               StaysOpen="False" Width="{Binding ActualWidth, ElementName=SendBox}" MinWidth="420"
               Opened="OnRecentOpened" Closed="OnRecentClosed">
            <Border Background="White" BorderBrush="#A0A0A0" BorderThickness="1">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Background="#F3F3F3">
                        <Button DockPanel.Dock="Right" Content="Clear history" Command="{Binding ClearHistoryCommand}" Padding="6,0" Margin="4,2" />
                        <TextBlock Text="Enter send · Shift+Enter or click to edit · Del remove" Foreground="#777" Margin="6,3" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="RecentList" ItemsSource="{Binding RecentItems}" MaxHeight="340" BorderThickness="0"
                             HorizontalContentAlignment="Stretch" PreviewKeyDown="OnRecentKeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <EventSetter Event="MouseLeftButtonUp" Handler="OnRecentItemClick" />
                                <Setter Property="Padding" Value="4,2" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}" Foreground="#777" FontSize="13"
                                            ToolTip="Remove from history" Click="OnRecentRemove" />
                                    <Button DockPanel.Dock="Right" Content="+ Macro" Style="{StaticResource FlatButton}" Foreground="#8A6400"
                                            ToolTip="Save as a macro button" Click="OnRecentSaveMacro" />
                                    <Button DockPanel.Dock="Right" Content="Send ▶" Style="{StaticResource FlatButton}" Foreground="#0B5CAD"
                                            FontWeight="SemiBold" ToolTip="Send again now (keeps this list open)" Click="OnRecentSend" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Tag}" Foreground="#888" FontSize="10" VerticalAlignment="Center" Margin="8,0" />
                                    <TextBlock Text="{Binding Text}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>

        <!-- Search bar -->
        <Border DockPanel.Dock="Top" Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolVis}}"
                Background="#FFF8E1" BorderBrush="#E6DCA8" BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Find" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="SearchBox" Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="Cascadia Mono, Consolas" FontSize="13" Padding="2,1" VerticalContentAlignment="Center"
                         PreviewKeyDown="OnSearchKeyDown" />
                <ComboBox Width="80" Margin="6,0,0,0" ItemsSource="{x:Static vm:MainViewModel.SendModes}" SelectedItem="{Binding SearchMode}"
                          ItemTemplate="{StaticResource EnumItem}" ToolTip="Pattern is Text, Hex (0D 0A) or Escaped (\r\n)" />
                <CheckBox Content="Match case" IsChecked="{Binding SearchMatchCase}" VerticalAlignment="Center" Margin="4,0,8,0" />
                <Button Content="▲" Command="{Binding FindPreviousCommand}" ToolTip="Previous match (Shift+F3 / Shift+Enter)" Padding="6,0" Margin="0,0,2,0" />
                <Button Content="▼" Command="{Binding FindNextCommand}" ToolTip="Next match (F3 / Enter)" Padding="6,0" Margin="0" />
                <TextBlock Text="{Binding SearchStatus}" VerticalAlignment="Center" Margin="10,0" Foreground="#555" />
                <Button Content="✕" Style="{StaticResource FlatButton}" Click="OnCloseSearch" ToolTip="Close (Esc)" />
            </StackPanel>
        </Border>

        <!-- Text view or hex view (Ctrl+H switches); they share the selection -->
        <Grid>
            <controls:LogTextView x:Name="LogView" Document="{Binding Document}" WordWrap="{Binding WordWrap}"
                                  IsPinned="{Binding IsPinned, Mode=TwoWay}" Selection="{Binding Selection}"
                                  Search="{Binding ActiveSearch}" />
            <controls:HexView x:Name="HexView" Document="{Binding HexDocument}" BytesPerRow="{Binding HexBytesPerRow}"
                              IsPinned="{Binding HexPinned, Mode=TwoWay}" Selection="{Binding Selection}"
                              Search="{Binding ActiveSearch}" Visibility="Collapsed" />
        </Grid>
    </DockPanel>
</Window>
