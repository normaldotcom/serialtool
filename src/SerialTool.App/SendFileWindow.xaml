<Window x:Class="SerialTool.App.SendFileWindow"
        Background="{DynamicResource AppBackground}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send File" SizeToContent="Height" Width="480" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12">
    <StackPanel Margin="14">
        <TextBlock Text="File (sent as raw bytes)" />
        <DockPanel Margin="0,3,0,2">
            <Button DockPanel.Dock="Right" Content="Browse…" Margin="6,0,0,0" Padding="10,2" Click="OnBrowse" />
            <TextBox x:Name="PathBox" Padding="2,3" TextChanged="OnPathChanged" />
        </DockPanel>
        <TextBlock x:Name="SizeText" Foreground="{DynamicResource MutedText}" Margin="0,0,0,10" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Chunk size" VerticalAlignment="Center" Width="120" />
            <TextBox x:Name="ChunkBox" Width="80" Padding="2,3" />
            <TextBlock Text="bytes" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="Delay between chunks" VerticalAlignment="Center" Width="120" />
            <TextBox x:Name="DelayBox" Width="80" Padding="2,3" />
            <TextBlock Text="ms (0 = as fast as the port allows)" VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource ErrorText}" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Send" IsDefault="True" Width="80" Margin="0,0,6,0" Click="OnOk" />
            <Button Content="Cancel" IsCancel="True" Width="80" />
        </StackPanel>
    </StackPanel>
</Window>
